{
	"name": "@standard/cloudflare-kit",
	"version": "0.1.0-alpha.0",
	"description": "Typed, framework-independent Cloudflare Workers primitives for bindings, KV, and HTTP caching.",
	"homepage": "https://github.com/Standard-Design/cloudflare-kit#readme",
	"bugs": {
		"url": "https://github.com/Standard-Design/cloudflare-kit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Standard-Design/cloudflare-kit.git"
	},
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./context": {
			"types": "./dist/context.d.ts",
			"import": "./dist/context.js"
		},
		"./env": {
			"types": "./dist/env.d.ts",
			"import": "./dist/env.js"
		},
		"./http-cache": {
			"types": "./dist/http-cache/index.d.ts",
			"import": "./dist/http-cache/index.js"
		},
		"./kv": {
			"types": "./dist/kv.d.ts",
			"import": "./dist/kv.js"
		},
		"./kv-cache": {
			"types": "./dist/kv-cache.d.ts",
			"import": "./dist/kv-cache.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@11.26.0",
	"scripts": {
		"prebuild": "node scripts/clean-dist.mjs",
		"build": "tsc -p tsconfig.build.json",
		"postbuild": "node scripts/assemble-package.mjs",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write .",
		"lint": "eslint .",
		"pack:test": "pnpm build && node scripts/test-packed-package.mjs",
		"package:check": "pnpm build && npm publish ./dist --dry-run --tag alpha && publint ./dist && attw --pack ./dist --profile esm-only",
		"prepare": "npm run build",
		"prepublishOnly": "node scripts/guard-root-publish.mjs",
		"release:pack": "pnpm build && npm pack ./dist",
		"release:publish": "pnpm build && npm publish ./dist --tag alpha",
		"test": "vitest run",
		"test:types": "tsc -p test/types/tsconfig.json",
		"typecheck": "tsc -p tsconfig.json && tsc -p test/types/tsconfig.json",
		"typegen": "wrangler types --config test/fixtures/worker/wrangler.jsonc test/fixtures/worker/worker-configuration.d.ts",
		"verify": "pnpm typegen && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm package:check && pnpm pack:test"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@cloudflare/workers-types": "^5.20260919.1",
		"@cloudflare/vitest-plugin": "^1.1.13",
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.10.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.8",
		"publint": "^0.3.24",
		"react-router": "^8.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^4.1.11",
		"wrangler": "^4.135.0"
	}
}
