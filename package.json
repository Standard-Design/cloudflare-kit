{
	"name": "@standard/cloudflare-kit",
	"version": "0.1.0-alpha.0",
	"description": "Typed, framework-independent Cloudflare Workers primitives for bindings, KV, and HTTP caching.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./context": {
			"types": "./dist/context.d.ts",
			"import": "./dist/context.js"
		},
		"./env": {
			"types": "./dist/env.d.ts",
			"import": "./dist/env.js"
		},
		"./http-cache": {
			"types": "./dist/http-cache/index.d.ts",
			"import": "./dist/http-cache/index.js"
		},
		"./kv": {
			"types": "./dist/kv.d.ts",
			"import": "./dist/kv.js"
		},
		"./kv-cache": {
			"types": "./dist/kv-cache.d.ts",
			"import": "./dist/kv-cache.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "pnpm@11.26.0",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write .",
		"lint": "eslint .",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json",
		"typegen": "wrangler types --config test/fixtures/worker/wrangler.jsonc test/fixtures/worker/worker-configuration.d.ts",
		"verify": "pnpm typegen && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260919.1",
		"@cloudflare/vitest-plugin": "^1.1.13",
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.10.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.9.8",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^4.1.11",
		"wrangler": "^4.135.0"
	}
}
